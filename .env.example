# Copy to .env and fill in. Never commit .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
ANTHROPIC_API_KEY=
CHANNEL3_API_KEY=
# Signs the Studio's per-browser view token (gg_view). 32+ characters; leave empty and the server makes one at boot
# (tokens then reset on every deploy, which is fine). Same name in Render if you want tokens to survive deploys.
VIEW_TOKEN_SECRET=
# AG Studio licence (Enterprise trial). Read at build time and shipped in the browser bundle by design; same name in Render.
# Leave empty until the Design Director has signed off the Studio dashboard: with a valid key, Behind the scenes switches to it.
VITE_AG_STUDIO_LICENSE=

# Turso store (runs, caps and the shopper's week survive restarts). Leave empty to keep the in-process store.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
