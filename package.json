{
  "name": "gilded-goose",
  "private": true,
  "version": "0.1.0",
  "description": "A shopping agent that finds, haggles and checks; only your tap pays. The AI proposes, plain code decides. PayPal AI Hackathon 2026, sandbox only.",
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "corepack pnpm -r build",
    "test": "corepack pnpm --filter @gilded-goose/trust --filter @goose/core --filter @gilded-goose/mcp test --reporter=default --reporter=json --outputFile.json=node_modules/.ratchet/tests.json",
    "typecheck": "corepack pnpm -r typecheck",
    "dev": "corepack pnpm --parallel --filter @goose/server --filter @goose/web dev",
    "e2e:sandbox": "node --env-file=.env scripts/e2e-sandbox.ts",
    "e2e:settle": "node --env-file=.env scripts/e2e-sandbox.ts settle",
    "e2e:settle-void": "node --env-file=.env scripts/e2e-sandbox.ts settle-void",
    "budget:first-screen": "node scripts/budget-first-screen.ts",
    "postdeploy": "sh -c 'U=${1:-https://gilded-goose.onrender.com}; node scripts/postdeploy-check.ts \"$U\"; a=$?; node scripts/console-sweep.ts \"$U\"; b=$?; [ $a -eq 0 ] && [ $b -eq 0 ]' postdeploy",
    "postdeploy:assets": "node scripts/postdeploy-check.ts",
    "postdeploy:console": "node scripts/console-sweep.ts",
    "postdeploy:webkit": "node scripts/webkit-walk.ts",
    "probe:waking": "node scripts/waking-probe.ts",
    "probe:offline-strip": "node scripts/offline-strip-probe.ts",
    "probe:first-routes": "node scripts/first-routes-probe.ts",
    "probe:ask-line": "node scripts/ask-line-probe.ts",
    "check": "sh scripts/heavy-lock.sh corepack pnpm run check:run",
    "check:run": "sh scripts/check-private.sh && sh scripts/check-copy.sh && sh scripts/check-node-ts.sh && node scripts/check-claims.ts && node scripts/mutants.ts --stale && corepack pnpm typecheck && corepack pnpm test && node scripts/redteam/plan-surfaces.ts && sh scripts/check-bundle.sh && node scripts/ratchet.ts",
    "check:bundle": "sh scripts/check-bundle.sh",
    "ratchet": "node scripts/ratchet.ts",
    "ratchet:record": "node scripts/ratchet-record.ts",
    "ratchet:board": "node scripts/ratchet-board.ts",
    "ratchet:axe": "node scripts/axe-routes.ts",
    "ratchet:walks": "node scripts/live-walks.ts",
    "keyboard:tour": "node scripts/keyboard-tour.ts",
    "budget:round": "node scripts/budget-round.ts",
    "judge:path": "node scripts/judge-path.ts",
    "motion": "node scripts/motion.ts",
    "screens": "node scripts/screens.ts",
    "mutants": "node scripts/mutants.ts",
    "saw:screens": "node scripts/saw-screens.ts",
    "speak:times": "node scripts/speak-times.ts",
    "voice:screens": "node scripts/voice-screens.ts",
    "mockup:screens": "node scripts/mockup-screens.ts",
    "control:no-guard": "node --env-file=.env trust/examples/control-no-guard.ts",
    "record:tape": "node --env-file=.env scripts/record-tape.ts",
    "video:takes": "node scripts/video-takes.ts",
    "video:kit": "node scripts/video-kit.ts"
  },
  "devDependencies": {
    "axe-core": "^4.10.0",
    "playwright": "^1.64.1",
    "@goose/core": "workspace:*",
    "@types/node": "^24.0.0"
  },
  "type": "module"
}
